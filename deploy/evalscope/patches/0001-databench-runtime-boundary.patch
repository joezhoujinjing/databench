+def _prediction_match(positions: list, page_size: int) -> dict:
+    if not positions:
+        return {'status': 'not-found'}
+    if len(positions) > 1:
+        return {'status': 'ambiguous'}
+    position = positions[0]
+    return {
+        'status': 'found',
+        'position': position + 1,
+        'page': position // page_size + 1,
+    }
