# Optional deployment retention policy. Copy to /opt/databench/deploy.env to override.
# auto: delete expired Databench archives/images; report: log only; off: disable cleanup.
DATABENCH_DEPLOY_CLEANUP_MODE=auto

# Keep the active/incoming image plus enough recent Databench releases for rollback.
DATABENCH_DEPLOY_KEEP_RELEASES=3

# Fail before upload/load when cleanup cannot leave this much free disk.
DATABENCH_DEPLOY_MIN_FREE_MIB=4096
