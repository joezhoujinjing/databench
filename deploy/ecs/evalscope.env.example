# The deployment script creates /opt/databench/evalscope.env with stable random secrets.
# Keep the real file on the ECS only and preserve it across upgrades.
EVALSCOPE_TASK_CONFIG_HMAC_KEY=REPLACE_WITH_64_HEX_CHARACTERS
EVALSCOPE_OPERATOR_TOKEN=REPLACE_WITH_64_HEX_CHARACTERS

# Test-profile bounds for the current 2-core / 3.4 GiB single ECS.
EVALSCOPE_INPUT_MAX_BYTES=268435456
EVALSCOPE_OUTPUT_MAX_BYTES=1073741824
EVALSCOPE_ARCHIVE_MAX_BYTES=268435456
EVALSCOPE_REQUEST_MAX_BYTES=1048576
EVALSCOPE_RESPONSE_MAX_BYTES=16777216
EVALSCOPE_DOCUMENT_MAX_BYTES=16777216
EVALSCOPE_DOCUMENT_TTL_SECONDS=900
EVALSCOPE_MAX_CONCURRENT_EVALS=1
EVALSCOPE_MAX_CONCURRENT_PERF=1
EVALSCOPE_MAX_TASKS=200
EVALSCOPE_TASK_RUNTIME_SECONDS=1800
EVALSCOPE_EVALUATION_SAMPLE_LIMIT_MAX=100
EVALSCOPE_EVALUATION_BATCH_SIZE_MAX=4
EVALSCOPE_EVALUATION_REPEATS_MAX=2
EVALSCOPE_PERFORMANCE_PARALLEL_MAX=2
EVALSCOPE_PERFORMANCE_REQUESTS_MAX=100
EVALSCOPE_PERFORMANCE_RATE_MAX=10
EVALSCOPE_MODEL_TOKENS_MAX=8192
EVALSCOPE_REQUEST_TIMEOUT_SECONDS_MAX=300
