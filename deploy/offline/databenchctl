#!/usr/bin/env bash

set -Eeuo pipefail

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
[ -n "$SCRIPT_PATH" ] || {
  printf '[databench] ERROR: could not resolve databenchctl path\n' >&2
  exit 1
}
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
# shellcheck source=lib/common.sh
source "${SCRIPT_DIR}/lib/common.sh"
# shellcheck source=lib/health.sh
source "${SCRIPT_DIR}/lib/health.sh"

usage() {
  cat <<'EOF'
Usage: databenchctl <command> [arguments]

Commands:
  status                         Show container status
  logs [service]                 Follow recent logs
  doctor                         Check PostgreSQL and object storage
  restart                        Drain and restart Worker, EvalScope, API and Web
  evalscope-status               Show internal drain and active-task state
  evalscope-drain                Stop admitting new evaluation tasks
  evalscope-resume               Resume evaluation task admission
  model [arguments]              Run the Model Registry operator CLI (request via stdin)
  model-credentials-project      Generate minimum API/EvalScope credential projections
  backup                         Create a consistent backup generation
  restore <generation> --confirm Restore a backup generation
  upgrade <extracted-bundle>     Upgrade using a new offline bundle
  rollback <version> [options]   Roll back to an installed release
  version                        Print the installed application version
EOF
}

require_root
RELEASE_DIR="$(current_release_dir)"
COMMAND="${1:-}"
case "$COMMAND" in
  status)
    compose_for_release "$RELEASE_DIR" ps
    ;;
  logs)
    shift
    compose_for_release "$RELEASE_DIR" logs --tail 200 --follow "$@"
    ;;
  doctor)
    run_doctor "$RELEASE_DIR"
    ;;
  restart)
    stop_application_services "$RELEASE_DIR"
    start_application_services "$RELEASE_DIR"
    wait_application_services "$RELEASE_DIR"
    run_doctor "$RELEASE_DIR"
    ;;
  evalscope-status)
    release_has_evalscope "$RELEASE_DIR" || die "this release does not contain EvalScope"
    evalscope_operator_request GET /internal/v1/operator/status
    ;;
  evalscope-drain)
    release_has_evalscope "$RELEASE_DIR" || die "this release does not contain EvalScope"
    evalscope_operator_request POST /internal/v1/operator/drain
    ;;
  evalscope-resume)
    release_has_evalscope "$RELEASE_DIR" || die "this release does not contain EvalScope"
    evalscope_operator_request POST /internal/v1/operator/resume
    ;;
  model)
    shift
    [ "$#" -gt 0 ] || die "usage: databenchctl model <list|show|versions|registration|deployment> ..."
    compose_for_release "$RELEASE_DIR" exec -T api databench model "$@"
    ;;
  model-credentials-project)
    exec "${RELEASE_DIR}/project-model-credentials.sh"
    ;;
  backup)
    exec "${RELEASE_DIR}/backup.sh"
    ;;
  restore)
    shift
    exec "${RELEASE_DIR}/restore.sh" "$@"
    ;;
  upgrade)
    [ "$#" -eq 2 ] || die "usage: databenchctl upgrade <extracted-bundle>"
    BUNDLE_DIR="$(cd "$2" && pwd)"
    exec "${BUNDLE_DIR}/upgrade.sh"
    ;;
  rollback)
    shift
    exec "${RELEASE_DIR}/rollback.sh" "$@"
    ;;
  version)
    current_version
    ;;
  help|-h|--help|'')
    usage
    ;;
  *)
    usage >&2
    die "unknown command: $COMMAND"
    ;;
esac
