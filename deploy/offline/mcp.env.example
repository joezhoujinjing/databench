# install.sh writes these non-secret runtime settings to /etc/databench/mcp.env once.
# Later install/upgrade runs reuse that file without requiring the environment variable again.
# The public base must be the stable URL that the internal agent can reach; never expose it publicly.
DATABENCH_MCP_ENABLED=true
DATABENCH_MCP_AUTH_MODE=none
DATABENCH_MCP_PUBLIC_BASE_URL=http://databench.internal/api
DATABENCH_MCP_ORIGINS=
