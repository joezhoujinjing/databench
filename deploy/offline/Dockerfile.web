FROM node:22-bookworm-slim AS build

ENV PNPM_HOME="/pnpm"
ENV PATH="${PNPM_HOME}:${PATH}"
WORKDIR /app

RUN corepack enable && corepack prepare pnpm@11.7.0 --activate

COPY deploy/offline/web-build-package.json ./package.json
COPY pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json ./
COPY apps/web ./apps/web

RUN --mount=type=cache,id=databench-pnpm-web-amd64,target=/pnpm/store \
  pnpm config set store-dir /pnpm/store \
  && cd apps/web \
  && pnpm install --ignore-workspace --lockfile-dir ../.. --frozen-lockfile --ignore-scripts
RUN cd apps/web && ./node_modules/.bin/vite build

FROM caddy:2.10.2-alpine

COPY deploy/offline/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /app/apps/web/dist /srv

EXPOSE 80
