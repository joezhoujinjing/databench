# install.sh writes the real root:root 0600 file to /etc/databench/swift.env.
# ui-only keeps the complete native Studio visible without requesting an
# NVIDIA device. Set gpu only on a host with an NVIDIA GPU and NVIDIA
# Container Toolkit. The generated Provider credential is shared by the API
# and Swift Provider and survives upgrades.
DATABENCH_SWIFT_ENABLED=false
DATABENCH_SWIFT_RUNTIME_MODE=ui-only
DATABENCH_SWIFT_GPU_DEVICE_ID=0
DATABENCH_SWIFT_STUDIO_PROVIDER_CREDENTIAL=generated
DATABENCH_SWIFT_PROVIDER_CREDENTIAL=generated
