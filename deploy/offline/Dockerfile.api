FROM node:22-bookworm-slim AS build

ENV PNPM_HOME="/pnpm"
ENV PATH="${PNPM_HOME}:${PATH}"
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
  ca-certificates \
  git \
  openssl \
  && rm -rf /var/lib/apt/lists/*
RUN corepack enable && corepack prepare pnpm@11.7.0 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json prisma.config.ts ./
COPY prisma ./prisma
COPY apps ./apps
COPY packages ./packages
COPY tooling ./tooling

RUN git init
RUN --mount=type=cache,id=databench-pnpm-api-amd64,target=/pnpm/store \
  pnpm config set store-dir /pnpm/store \
  && pnpm install --frozen-lockfile
RUN pnpm --filter @databench/api... --filter @databench/cli... build
RUN pnpm --filter @databench/api deploy --prod --legacy /prod/apps/api
RUN install -d /prod/apps/cli \
  && cp apps/cli/package.json /prod/apps/cli/package.json \
  && cp -a apps/cli/dist /prod/apps/cli/dist \
  && ln -s ../api/node_modules /prod/apps/cli/node_modules \
  && cp package.json prisma.config.ts /prod/ \
  && cp -a prisma /prod/prisma \
  && ln -s apps/api/node_modules /prod/node_modules
RUN cd /prod && ./node_modules/.bin/prisma generate

ARG DATABENCH_RELEASE_VERSION=0.0.0
RUN node -e "const fs=require('node:fs');const path='/prod/package.json';const value=JSON.parse(fs.readFileSync(path,'utf8'));value.version=process.argv[1];fs.writeFileSync(path,JSON.stringify(value,null,2)+'\\n')" "$DATABENCH_RELEASE_VERSION"

FROM node:22-bookworm-slim AS runtime

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
  ca-certificates \
  openssl \
  && rm -rf /var/lib/apt/lists/*

ENV DATABENCH_EVALSCOPE_ALLOWED_ROUTES_MANIFEST=/app/evalscope-api-routes.json
ENV DATABENCH_EVALSCOPE_INTRANET_HTTP_DOCUMENTS=true
ENV NODE_ENV=production
ENV PORT=8000

COPY --from=build --chown=node:node /prod /app
COPY --chown=node:node deploy/evalscope/api-routes.json /app/evalscope-api-routes.json
COPY --chown=node:node third_party/ms-swift/gradio-routes.json /app/swift-studio-gradio-routes.json

RUN ln -s /app/apps/cli/dist/index.js /usr/local/bin/databench

USER node

EXPOSE 8000

HEALTHCHECK --interval=20s --timeout=5s --start-period=20s --retries=6 \
  CMD node -e "fetch('http://127.0.0.1:8000/health').then((response)=>process.exit(response.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "apps/api/dist/index.js"]
