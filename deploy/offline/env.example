# This file documents the generated secret contract. install.sh writes the real
# values to /etc/databench/databench.env with root:root 0600 permissions.
POSTGRES_USER=databench
POSTGRES_PASSWORD=generated
POSTGRES_DB=databench
DATABASE_URL=postgresql://databench:generated@postgres:5432/databench?schema=public

MINIO_ROOT_USER=databench_root
MINIO_ROOT_PASSWORD=generated
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=databench
S3_ACCESS_KEY_ID=databench_app
S3_SECRET_ACCESS_KEY=generated
S3_FORCE_PATH_STYLE=true
DATABENCH_OBJECT_STORE=s3

DATABENCH_CORS_ORIGINS=
DATABENCH_ROOT=/var/lib/databench
DATABENCH_V2_CURSOR_SECRET=generated
DATABENCH_SERVICE_CREDENTIAL=generated
DATABENCH_EVALUATION_ARCHIVE_MAX_BYTES=1073741824
DATABENCH_EVALUATION_ARCHIVE_SIGNED_URL_TTL_MS=900000
PORT=8000
