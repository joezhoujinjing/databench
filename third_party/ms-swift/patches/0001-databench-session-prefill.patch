+_SESSION_CONTEXT_KEYS = {
+    'provider_session_id',
+    'status',
+    'dataset_version',
+    'display_label',
+    'dataset_path',
+    'output_dir',
+    'logging_dir',
+    'provider_generation',
+}
+_SESSION_CONTEXT_MAX_BYTES = 64 * 1024
+
+
+def _session_banner(context, lang):
+    if context is None:
+        message = {
+            'zh': '请先在 Databench 中选择 Dataset 并打开 Studio Session。',
+            'en': 'Select a Dataset in Databench and open a Studio Session first.',
+        }[lang]
+        return f'<div class="databench-swift-session"><strong>Databench:</strong> {message}</div>'
+    label = escape(context['display_label'])
+    dataset_version = escape(context['dataset_version'])
+    message = {
+        'zh': '当前 Dataset 已锁定；只有当前 Session output root 内的产物可导入。',
+        'en': 'The current Dataset is locked; only artifacts inside this Session output root can be imported.',
+    }[lang]
+    return (
+        '<div class="databench-swift-session"><strong>Databench:</strong> '
+        f'{label} · <code>{dataset_version}</code><br>{message}</div>')
+
+
+def _read_session_context():
+    port = int(os.environ.get('DATABENCH_SWIFT_PROVIDER_PORT', '7861'))
+    request = urllib.request.Request(
+        f'http://127.0.0.1:{port}/sessions/current/context',
+        headers={'Accept': 'application/json'})
+    credential = os.environ.get('DATABENCH_SWIFT_PROVIDER_CREDENTIAL')
+    if credential:
+        request.add_header('Authorization', f'Bearer {credential}')
+    try:
+        with urllib.request.urlopen(request, timeout=3) as response:
+            payload = response.read(_SESSION_CONTEXT_MAX_BYTES + 1)
+    except (OSError, urllib.error.HTTPError, urllib.error.URLError, ValueError):
+        return None
+    if len(payload) > _SESSION_CONTEXT_MAX_BYTES:
+        return None
+    try:
+        context = json.loads(payload)
+    except (UnicodeDecodeError, json.JSONDecodeError):
+        return None
+    if not isinstance(context, dict) or set(context) != _SESSION_CONTEXT_KEYS or context.get('status') != 'ready':
+        return None
+    for field in ('provider_session_id', 'dataset_version', 'display_label', 'dataset_path', 'output_dir', 'logging_dir'):
+        if not isinstance(context.get(field), str) or not context[field]:
+            return None
+    if not all(os.path.isabs(context[field]) for field in ('dataset_path', 'output_dir', 'logging_dir')):
+        return None
+    return context
+
+
+def _load_session_context(lang, include_banner=False):
+    context = _read_session_context()
+    values = [gr.skip(), gr.skip(), gr.skip()] if context is None else [
+        [context['dataset_path']], context['output_dir'], context['logging_dir']]
+    if include_banner:
+        return [_session_banner(context, lang), *values]
+    return values
+
 
