{
  "name": "@databench/v1-retirement",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format esm --sourcemap --clean && tsc --emitDeclarationOnly",
    "retire": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "node ../../scripts/with-test-db-schema.mjs --reset databench_test_v1_retirement pnpm --dir ../.. exec prisma migrate deploy && node ../../scripts/with-test-db-schema.mjs databench_test_v1_retirement vitest run --passWithNoTests"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1079.0",
    "@databench/hashing": "workspace:*",
    "@databench/store": "workspace:*",
    "@databench/workspace": "workspace:*",
    "ali-oss": "^6.23.0",
    "pg": "^8.22.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/pg": "^8.18.0",
    "tsx": "^4.20.0"
  }
}
