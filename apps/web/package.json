{
  "name": "@databench/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build && node scripts/check-evaluation-bundle.mjs",
    "bundle:check": "node scripts/check-evaluation-bundle.mjs",
    "dev": "vite dev --host 0.0.0.0",
    "gen:client": "node scripts/generate-client.mjs",
    "gen:client:check": "node scripts/generate-client.mjs --check",
    "openapi:check": "pnpm gen:client:check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.80.0",
