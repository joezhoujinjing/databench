{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://databench.local/schema/model-credentials-v1.json",
  "title": "Databench Model Credential Registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile", "generation", "projection_for", "credentials"],
  "properties": {
    "profile": { "const": "model-credentials-v1" },
    "generation": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "projection_for": { "enum": ["authority", "api-health", "evalscope"] },
    "credentials": {
      "type": "object",
      "maxProperties": 256,
      "propertyNames": { "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
      "additionalProperties": { "$ref": "#/$defs/credential" }
    }
  },
  "$defs": {
    "credential": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "secret", "allowed_consumers", "allowed_deployments"],
      "properties": {
        "kind": { "const": "bearer" },
        "secret": { "type": "string", "minLength": 1, "maxLength": 8192 },
        "allowed_consumers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "enum": ["api-health", "evalscope"] }
        },
        "allowed_deployments": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "uniqueItems": true,
          "items": { "type": "string", "format": "uuid" }
        }
      }
    }
  }
}
