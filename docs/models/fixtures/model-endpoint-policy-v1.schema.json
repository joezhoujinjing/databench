{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://databench.local/schema/model-endpoint-policy-v1.json",
  "title": "Databench Model Endpoint Policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile", "generation", "private_network", "public_network"],
  "properties": {
    "profile": { "const": "model-endpoint-policy-v1" },
    "generation": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "private_network": {
      "type": "array",
      "maxItems": 256,
      "items": { "$ref": "#/$defs/privateRule" }
    },
    "public_network": {
      "type": "array",
      "maxItems": 256,
      "items": { "$ref": "#/$defs/publicRule" }
    }
  },
  "$defs": {
    "hostname": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^(?![.*])(?=.{1,253}$)[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?$"
    },
    "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "cidr": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64,
      "pattern": "^[0-9A-Fa-f:.]+/[0-9]{1,3}$"
    },
    "privateRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostname", "cidrs", "schemes", "ports"],
      "properties": {
        "hostname": { "$ref": "#/$defs/hostname" },
        "cidrs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/cidr" }
        },
        "schemes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "enum": ["http", "https"] }
        },
        "ports": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/port" }
        }
      }
    },
    "publicRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostname", "ports"],
      "properties": {
        "hostname": { "$ref": "#/$defs/hostname" },
        "ports": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/port" }
        }
      }
    }
  }
}
