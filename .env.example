DATABASE_URL="postgresql://databench:databench@localhost:55432/databench?schema=public"

# Local development uses MinIO through the S3-compatible adapter. Production ECS
# pins DATABENCH_OBJECT_STORE=oss in deploy/ecs/docker-compose.yml and uses
# OSS_* from /opt/databench/api.env.
DATABENCH_OBJECT_STORE="s3"
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="databench"
S3_ACCESS_KEY_ID="databench"
S3_SECRET_ACCESS_KEY="databench-secret"
S3_FORCE_PATH_STYLE="true"

# Production / explicit OSS mode:
# DATABENCH_OBJECT_STORE="oss"
# OSS_REGION="oss-cn-hongkong"
# OSS_BUCKET="databench-data"
# OSS_ACCESS_KEY_ID=""
# OSS_ACCESS_KEY_SECRET=""
# OSS_INTERNAL="true"
# OSS_ENDPOINT="https://oss-cn-hongkong.aliyuncs.com"   # optional; overrides region
# OSS_SECURE="false"                                   # opt out of HTTPS; only for a trusted local proxy

DATABENCH_CORS_ORIGINS="http://localhost:5173"
# Optional deployment-facing OpenAPI server URL. The offline Compose sets this
# to /api; hosted/direct API deployments normally leave it unset.
# DATABENCH_OPENAPI_SERVER_URL="/api"
DATABENCH_ROOT="./bench"
# At least 16 UTF-8 bytes. Keep stable across API instances and restarts so
# signed refs/lineage cursors remain valid for their advertised lifetime.
DATABENCH_V2_CURSOR_SECRET="replace-with-a-random-secret"
PORT="8000"
