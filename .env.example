DATABASE_URL="postgresql://databench:databench@localhost:55432/databench?schema=public"

# Object store = Aliyun OSS (data plane). There is no local object store; set
# real OSS credentials to run the app or the store integration test. Use a RAM
# sub-account key scoped to the bucket, and pre-create the bucket.
OSS_REGION="oss-cn-hangzhou"
OSS_BUCKET="databench-test"
OSS_ACCESS_KEY_ID=""
OSS_ACCESS_KEY_SECRET=""
# OSS_ENDPOINT="https://oss-cn-hangzhou.aliyuncs.com"   # optional; overrides region
# OSS_INTERNAL="true"                                    # use the VPC/internal endpoint (no egress cost from ECS/ACK)
# OSS_SECURE="false"                                     # opt out of HTTPS (default is on); only for a trusted local proxy

DATABENCH_CORS_ORIGINS="http://localhost:5173"
PORT="8000"
