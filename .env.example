DATABASE_URL="postgresql://databench:databench@localhost:55432/databench?schema=public"

# Local development uses MinIO through the S3-compatible adapter. Production ECS
# pins DATABENCH_OBJECT_STORE=oss in deploy/ecs/docker-compose.yml and uses
# OSS_* from /opt/databench/api.env.
DATABENCH_OBJECT_STORE="s3"
S3_ENDPOINT="http://localhost:9000"
# Optional URL embedded in signed staging links when the private Worker reaches
# MinIO through a different host/network address. Defaults to S3_ENDPOINT.
# S3_WORKER_ENDPOINT="http://host.docker.internal:9000"
S3_REGION="us-east-1"
S3_BUCKET="databench"
S3_ACCESS_KEY_ID="databench"
S3_SECRET_ACCESS_KEY="databench-secret"
S3_FORCE_PATH_STYLE="true"

# Production / explicit OSS mode:
# DATABENCH_OBJECT_STORE="oss"
# OSS_REGION="oss-cn-hongkong"
# OSS_BUCKET="databench-data"
# OSS_ACCESS_KEY_ID=""
# OSS_ACCESS_KEY_SECRET=""
# OSS_INTERNAL="true"
# OSS_ENDPOINT="https://oss-cn-hongkong.aliyuncs.com"   # optional; overrides region
# OSS_SECURE="false"                                   # opt out of HTTPS; only for a trusted local proxy

DATABENCH_CORS_ORIGINS="http://localhost:5173"
# Optional deployment-facing OpenAPI server URL. The offline Compose sets this
# to /api; hosted/direct API deployments normally leave it unset.
# DATABENCH_OPENAPI_SERVER_URL="/api"
DATABENCH_ROOT="./bench"
# At least 16 UTF-8 bytes. Keep stable across API instances and restarts so
# signed refs/lineage cursors remain valid for their advertised lifetime.
DATABENCH_V2_CURSOR_SECRET="replace-with-a-random-secret"

# Completed EvalScope result archives use 15-minute, exact-key conditional PUT
# descriptors. Both values may be lowered; the byte limit cannot exceed 1 GiB.
DATABENCH_EVALUATION_ARCHIVE_MAX_BYTES="1073741824"
DATABENCH_EVALUATION_ARCHIVE_SIGNED_URL_TTL_MS="900000"

# Model Registry is available in local/trusted-intranet profiles. Repository
# resolution stays offline unless an operator explicitly selects connected mode
# and supplies an absolute allowlisted config. Endpoint access fails closed when
# the policy/projection paths are omitted.
DATABENCH_MODEL_REPOSITORY_MODE="offline"
DATABENCH_MODEL_REPOSITORY_TIMEOUT_MS="5000"
# DATABENCH_MODEL_REPOSITORY_CONFIG="/absolute/path/model-repositories.json"
# DATABENCH_MODEL_ENDPOINT_POLICY="/absolute/path/model-endpoint-policy.json"
# DATABENCH_MODEL_CREDENTIALS="/absolute/path/api-model-credentials.json"
# DATABENCH_SERVICE_CREDENTIAL="replace-with-a-distinct-internal-service-token"
DATABENCH_MODEL_ENDPOINT_CONNECT_TIMEOUT_MS="2000"
DATABENCH_MODEL_ENDPOINT_HEADERS_TIMEOUT_MS="3000"
DATABENCH_MODEL_ENDPOINT_BODY_TIMEOUT_MS="3000"
DATABENCH_MODEL_ENDPOINT_TOTAL_TIMEOUT_MS="5000"

# Optional private Python Worker. Keep disabled unless the native Worker is
# running on the configured loopback/private-network target.
DATABENCH_WORKER_ENABLED="false"
DATABENCH_WORKER_TARGET="127.0.0.1:50051"
DATABENCH_WORKER_JOB_DEADLINE_MS="900000"
DATABENCH_WORKER_LEASE_MS="30000"
DATABENCH_WORKER_HEARTBEAT_MS="10000"
DATABENCH_WORKER_TERMINAL_EOF_MS="5000"
DATABENCH_WORKER_SIGNED_URL_TTL_MS="1200000"
DATABENCH_WORKER_SHUTDOWN_MS="30000"

# Optional EvalScope backend. The Web evaluation routes remain visible while
# this runtime is disabled. Enabling requires a private HTTP origin and the
# exact pinned route manifest; the offline bundle owns the production values.
DATABENCH_EVALSCOPE_ENABLED="false"
# DATABENCH_EVALSCOPE_INTERNAL_BASE_URL="http://127.0.0.1:9000"
# DATABENCH_EVALSCOPE_ALLOWED_ROUTES_MANIFEST="/absolute/path/evalscope-api-routes.json"
DATABENCH_EVALSCOPE_INTRANET_HTTP_DOCUMENTS="false"
DATABENCH_EVALSCOPE_INVOKE_TIMEOUT_MS="86400000"
DATABENCH_EVALSCOPE_REQUEST_MAX_BYTES="1048576"
DATABENCH_EVALSCOPE_RESPONSE_MAX_BYTES="16777216"
DATABENCH_EVALSCOPE_TIMEOUT_MS="30000"

# Optional full ms-swift Studio gateway. It stays disabled on ordinary local
# development. Enabling requires the private Gradio/Provider/API origins and
# the pinned route manifest; GPU validation remains a separate deferred gate.
DATABENCH_SWIFT_STUDIO_ENABLED="false"
# DATABENCH_SWIFT_STUDIO_INTERNAL_BASE_URL="http://127.0.0.1:7860"
# DATABENCH_SWIFT_STUDIO_PROVIDER_BASE_URL="http://127.0.0.1:7861"
# DATABENCH_SWIFT_STUDIO_DATABENCH_BASE_URL="http://127.0.0.1:8000"
# DATABENCH_SWIFT_STUDIO_ROUTES_MANIFEST="/absolute/path/swift-studio-gradio-routes.json"
# DATABENCH_SWIFT_STUDIO_PROVIDER_CREDENTIAL="replace-with-a-provider-token"

# Optional MCP import surface. It remains disabled unless an operator provides
# a stable agent-reachable base URL and explicitly accepts auth_mode=none for a
# trusted intranet profile.
DATABENCH_MCP_ENABLED="false"
# DATABENCH_MCP_AUTH_MODE="none"
# DATABENCH_MCP_PUBLIC_BASE_URL="http://127.0.0.1:8000"
# DATABENCH_MCP_ORIGINS="http://127.0.0.1:5173"

PORT="8000"
