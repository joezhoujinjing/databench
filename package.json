{
  "name": "databench-ts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "codegen:worker": "bash scripts/generate-worker-proto.sh",
    "codegen:worker:check": "bash scripts/check-worker-proto-generated.sh",
    "dev": "turbo run dev --parallel",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:worker:product-e2e": "node scripts/p7-worker-product-e2e.mjs",
    "test:worker:python": "bash workers/python/scripts/check-package.sh",
    "test:evalscope:python": "uv run --project workers/evalscope --frozen pytest -q workers/evalscope/tests",
    "test:swift:python": "uv run --project workers/swift-studio --frozen pytest -q workers/swift-studio/tests",
    "evalscope:parity:check": "node scripts/check-evalscope-parity.mjs",
    "evalscope:parity:check:green": "node scripts/check-evalscope-parity.mjs --require-green",
    "evalscope:parity:test": "node --test scripts/check-evalscope-parity.test.mjs",
    "ecs:check": "bash deploy/ecs/test/cleanup.test.sh",
    "swift:baseline:check": "node scripts/check-swift-baseline.mjs",
    "swift:baseline:check:green": "node scripts/check-swift-baseline.mjs --require-s0-green",
    "swift:baseline:test": "node --test scripts/check-swift-baseline.test.mjs",
    "swift:s1:gpu:run": "node scripts/run-swift-s1-gpu-gate.mjs",
    "swift:s1:gpu:driver:test": "python3 scripts/run-swift-s1-gpu-driver.test.py",
    "swift:s1:gpu:runner:test": "node --test scripts/run-swift-s1-gpu-gate.test.mjs",
    "swift:s1:gpu:evidence:check": "node scripts/check-swift-s1-gpu-evidence.mjs",
    "swift:s1:gpu:evidence:test": "node --test scripts/check-swift-s1-gpu-evidence.test.mjs",
    "swift:lock:generate": "node scripts/generate-swift-runtime-lock.mjs",
    "models:status:check": "node scripts/check-model-registry-status.mjs",
    "models:status:test": "node --test scripts/check-model-registry-status.test.mjs",
    "models:migration:check": "node scripts/with-test-db-schema.mjs --reset databench_test_models_forward node scripts/check-model-registry-forward-migration.mjs",
    "v2:status:check": "node scripts/check-v2-status.mjs",
    "v1:retire": "pnpm --filter @databench/v1-retirement retire",
    "openapi:check": "turbo run openapi:check",
    "offline:check": "bash deploy/offline/test/offline-scripts.test.sh && bash deploy/offline/test/update-bundle.test.sh",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@bufbuild/buf": "1.72.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@types/node": "^24.0.0",
    "lefthook": "^1.11.0",
    "pg": "^8.22.0",
    "prisma": "^7.8.0",
    "tsup": "^8.3.0",
    "ts-proto": "2.12.0",
    "turbo": "^2.5.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
