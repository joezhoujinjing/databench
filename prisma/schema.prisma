generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

model V2IdentityNamespace {
  id        String   @id @db.Uuid
  scope     String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  claims                 V2IdentityClaim[]
  refs                   V2Ref[]
  resultRefTransformJobs V2TransformJob[]        @relation("V2TransformJobResultRefNamespace")
  evaluationRuns         V2EvaluationRun[]
  swiftStudioSessions    V2SwiftStudioSession[]
  modelArtifactImports   V2ModelArtifactImport[]
  modelArtifacts         V2ModelArtifact[]
  modelDeployments       V2ModelDeployment[]

  @@map("identity_namespaces_v2")
}

model V2IdentityClaim {
  namespaceId     String   @map("namespace_id") @db.Uuid
  entityKind      String   @map("entity_kind")
  claimKeyDigest  String   @map("claim_key_digest") @db.Char(64)
  claimProfile    String   @map("claim_profile")
  requestProfile  String   @map("request_profile")
  creationProfile String   @map("creation_profile")
  entityId        String   @map("entity_id")
  requestDigest   String   @map("request_digest") @db.Char(64)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  namespace V2IdentityNamespace @relation(fields: [namespaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([namespaceId, entityKind, claimKeyDigest])
  @@unique([namespaceId, entityId], map: "uq_identity_claims_v2_entity")
  @@map("identity_claims_v2")
}

model V2DatasetSnapshot {
  version             String   @id @db.Char(64)
  identityProfile     String   @map("identity_profile")
  recordSchemaVersion String   @map("record_schema_version")
  numRecords          BigInt   @map("num_records")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  layouts                 V2DatasetLayout[]
  refs                    V2Ref[]
  producingRuns           V2Run[]
  consumingRunInputs      V2RunInput[]
  representativeRevisions V2RecordRevisionLocation[]
  inputTransformJobs      V2TransformJob[]           @relation("V2TransformJobInput")
  outputTransformJobs     V2TransformJob[]           @relation("V2TransformJobOutput")
  resultRefTransformJobs  V2TransformJob[]           @relation("V2TransformJobResultRefVersion")
  evaluationRuns          V2EvaluationRun[]
  swiftStudioSessions     V2SwiftStudioSession[]
  modelArtifactImports    V2ModelArtifactImport[]
  modelArtifacts          V2ModelArtifact[]

  @@map("dataset_snapshots_v2")
}

model V2DatasetLayout {
  datasetVersion    String   @map("dataset_version") @db.Char(64)
  layoutVersion     String   @map("layout_version")
  artifactDigest    String   @map("artifact_digest") @db.Char(64)
  artifactSizeBytes BigInt   @map("artifact_size_bytes")
  manifestKey       String   @map("manifest_key")
  columns           Json     @map("columns_json")
  committedAt       DateTime @default(now()) @map("committed_at") @db.Timestamptz(6)

  dataset V2DatasetSnapshot @relation(fields: [datasetVersion], references: [version], onDelete: Restrict, onUpdate: Restrict)

  @@id([datasetVersion, layoutVersion])
  @@unique([manifestKey], map: "uq_dataset_layouts_v2_manifest_key")
  @@map("dataset_layouts_v2")
}

model V2Run {
  id            String   @unique @db.Char(68)
  cacheKey      String   @id @map("cache_key") @db.Char(64)
  lineageSeq    BigInt   @unique @default(autoincrement()) @map("lineage_seq")
  op            String
  opVersion     String   @map("op_version")
  params        Json     @map("params_json")
  outputVersion String   @map("output_version") @db.Char(64)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  output V2DatasetSnapshot @relation(fields: [outputVersion], references: [version], onDelete: Restrict, onUpdate: Restrict)
  inputs V2RunInput[]

  @@index([outputVersion], map: "idx_runs_v2_output")
  @@map("runs_v2")
}

model V2RunInput {
  cacheKey       String @map("cache_key") @db.Char(64)
  position       Int
  datasetVersion String @map("dataset_version") @db.Char(64)

  run     V2Run             @relation(fields: [cacheKey], references: [cacheKey], onDelete: Restrict, onUpdate: Restrict)
  dataset V2DatasetSnapshot @relation(fields: [datasetVersion], references: [version], onDelete: Restrict, onUpdate: Restrict)

  @@id([cacheKey, position])
  @@index([datasetVersion], map: "idx_run_inputs_v2_dataset")
  @@map("run_inputs_v2")
}

model V2RecordRevisionLocation {
  recordId       String @map("record_id") @db.Char(68)
  recordDigest   String @map("record_digest") @db.Char(64)
  datasetVersion String @map("dataset_version") @db.Char(64)

  dataset    V2DatasetSnapshot    @relation(fields: [datasetVersion], references: [version], onDelete: Restrict, onUpdate: Restrict)
  childEdges V2RecordParentEdge[]

  @@id([recordId, recordDigest])
  @@index([datasetVersion], map: "idx_record_revision_locations_v2_dataset")
  @@map("record_revision_locations_v2")
}

model V2RecordParentEdge {
  childRecordId      String @map("child_record_id") @db.Char(68)
  childRecordDigest  String @map("child_record_digest") @db.Char(64)
  position           Int
  parentRecordId     String @map("parent_record_id") @db.Char(68)
  parentRecordDigest String @map("parent_record_digest") @db.Char(64)

  child V2RecordRevisionLocation @relation(fields: [childRecordId, childRecordDigest], references: [recordId, recordDigest], onDelete: Restrict, onUpdate: Restrict)

  @@id([childRecordId, childRecordDigest, position])
  @@unique([childRecordId, childRecordDigest, parentRecordId], map: "uq_record_parent_edges_v2_parent_id")
  @@index([parentRecordId, parentRecordDigest], map: "idx_record_parent_edges_v2_parent")
  @@map("record_parent_edges_v2")
}

model V2Ref {
  namespaceId String    @map("namespace_id") @db.Uuid
  name        String
  version     String    @db.Char(64)
  message     String?
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  namespace V2IdentityNamespace @relation(fields: [namespaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  dataset   V2DatasetSnapshot   @relation(fields: [version], references: [version], onDelete: Restrict, onUpdate: Restrict)

  @@id([namespaceId, name])
  @@index([version], map: "idx_refs_v2_version")
  @@map("refs_v2")
}

model V2TransformJob {
  id                   String    @id @db.Char(68)
  cacheKey             String    @unique @map("cache_key") @db.Char(64)
  op                   String
  opVersion            String    @map("op_version")
  params               Json      @map("params_json")
  inputVersion         String    @map("input_version") @db.Char(64)
  capabilityName       String    @map("capability_name")
  capabilityVersion    String    @map("capability_version")
  status               String
  attempt              Int       @default(0)
  leaseOwner           String?   @map("lease_owner")
  leaseToken           Bytes?    @map("lease_token") @db.ByteA
  leaseExpiresAt       DateTime? @map("lease_expires_at") @db.Timestamptz(6)
  progress             Json?     @map("progress_json")
  inputKey             String?   @map("input_key")
  outputKey            String?   @map("output_key")
  inputCount           BigInt    @map("input_count")
  outputCount          BigInt?   @map("output_count")
  outputVersion        String?   @map("output_version") @db.Char(64)
  resultRefNamespaceId String?   @map("result_ref_namespace_id") @db.Uuid
  resultRefName        String?   @map("result_ref_name")
  resultRefStatus      String?   @map("result_ref_status")
  resultRefVersion     String?   @map("result_ref_version") @db.Char(64)
  cacheHit             Boolean   @default(false) @map("cache_hit")
  error                Json?     @map("error_json")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  startedAt            DateTime? @map("started_at") @db.Timestamptz(6)
  finishedAt           DateTime? @map("finished_at") @db.Timestamptz(6)
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  input              V2DatasetSnapshot    @relation("V2TransformJobInput", fields: [inputVersion], references: [version], onDelete: Restrict, onUpdate: Restrict)
  output             V2DatasetSnapshot?   @relation("V2TransformJobOutput", fields: [outputVersion], references: [version], onDelete: Restrict, onUpdate: Restrict)
  resultRefNamespace V2IdentityNamespace? @relation("V2TransformJobResultRefNamespace", fields: [resultRefNamespaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  resultRefDataset   V2DatasetSnapshot?   @relation("V2TransformJobResultRefVersion", fields: [resultRefVersion], references: [version], onDelete: Restrict, onUpdate: Restrict)

  @@index([status, createdAt, id], map: "idx_transform_jobs_v2_queue")
  @@index([leaseExpiresAt], map: "idx_transform_jobs_v2_lease_expiry")
  @@map("transform_jobs_v2")
}

model V2EvaluationRun {
  id                      String    @id @db.Uuid
  namespaceId             String    @map("namespace_id") @db.Uuid
  provider                String
  providerTaskId          String    @map("provider_task_id")
  createProfile           String    @default("evaluation-run-create-v1") @map("create_profile")
  createRequestDigest     String    @map("create_request_digest") @db.Char(64)
  providerReportIds       Json?     @map("provider_report_ids_json")
  datasetVersion          String    @map("dataset_version") @db.Char(64)
  sourceRef               String?   @map("source_ref")
  converter               String
  converterVersion        String    @map("converter_version")
  converterOptions        Json      @map("converter_options_json")
  fidelityDigest          String    @map("fidelity_digest") @db.Char(64)
  benchmark               String
  modelName               String?   @map("model_name")
  modelDeploymentId       String?   @map("model_deployment_id") @db.Uuid
  modelArtifactId         String?   @map("model_artifact_id") @db.Uuid
  modelDeploymentDigest   String?   @map("model_deployment_digest") @db.Char(64)
  evalscopeCommit         String?   @map("evalscope_commit")
  status                  String
  metrics                 Json?     @map("metrics_json")
  error                   Json?     @map("error_json")
  archiveStatus           String    @default("not_requested") @map("archive_status")
  archiveAttempt          Int       @default(0) @map("archive_attempt")
  resultArtifactKey       String?   @map("result_artifact_key")
  resultArtifactDigest    String?   @map("result_artifact_digest") @db.Char(64)
  resultArtifactSizeBytes BigInt?   @map("result_artifact_size_bytes")
  archiveError            Json?     @map("archive_error_json")
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  startedAt               DateTime? @map("started_at") @db.Timestamptz(6)
  finishedAt              DateTime? @map("finished_at") @db.Timestamptz(6)
  updatedAt               DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  namespace       V2IdentityNamespace @relation(fields: [namespaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  dataset         V2DatasetSnapshot   @relation(fields: [datasetVersion], references: [version], onDelete: Restrict, onUpdate: Restrict)
  modelDeployment V2ModelDeployment?  @relation("V2EvaluationRunDeployment", fields: [namespaceId, modelDeploymentId, modelArtifactId, modelDeploymentDigest], references: [namespaceId, id, artifactId, createDigest], onDelete: Restrict, onUpdate: Restrict)

  @@unique([namespaceId, provider, providerTaskId], map: "uq_evaluation_runs_v2_provider_task")
  @@index([namespaceId, datasetVersion, createdAt, id], map: "idx_evaluation_runs_v2_dataset")
  @@index([namespaceId, status, createdAt, id], map: "idx_evaluation_runs_v2_status")
  @@map("evaluation_runs_v2")
}

model V2SwiftStudioSession {
  id                      String    @id @db.Uuid
  namespaceId             String    @map("namespace_id") @db.Uuid
  createDigest            String    @map("create_digest") @db.Char(64)
  status                  String
  datasetVersion          String    @map("dataset_version") @db.Char(64)
  displayRef              String?   @map("display_ref")
  converter               String
  converterVersion        String    @map("converter_version")
  normalizedOptions       Json      @map("normalized_options_json")
  fidelityDigest          String    @map("fidelity_digest") @db.Char(64)
  exportOutputCount       BigInt    @map("export_output_count")
  exportDigest            String?   @map("export_digest") @db.Char(64)
  exportSizeBytes         BigInt?   @map("export_size_bytes")
  provider                String
  providerSessionId       String    @map("provider_session_id")
  upstreamCommit          String    @map("upstream_commit") @db.Char(40)
  imageDigest             String    @map("image_digest") @db.Char(64)
  runtimeCapabilityDigest String    @map("runtime_capability_digest") @db.Char(64)
  failure                 Json?     @map("failure_json")
  preparationOwnerToken   String    @map("preparation_owner_token") @db.Uuid
  preparationAbandonedAt  DateTime? @map("preparation_abandoned_at") @db.Timestamptz(6)
  preparationExpiresAt    DateTime  @default(dbgenerated("CURRENT_TIMESTAMP + INTERVAL '5 hours'")) @map("preparation_expires_at") @db.Timestamptz(6)
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  readyAt                 DateTime? @map("ready_at") @db.Timestamptz(6)
  closedAt                DateTime? @map("closed_at") @db.Timestamptz(6)
  updatedAt               DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  namespace            V2IdentityNamespace     @relation(fields: [namespaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  dataset              V2DatasetSnapshot       @relation(fields: [datasetVersion], references: [version], onDelete: Restrict, onUpdate: Restrict)
  modelArtifactImports V2ModelArtifactImport[]
  modelArtifacts       V2ModelArtifact[]

  @@unique([namespaceId, createDigest], map: "uq_swift_studio_sessions_v2_create_digest")
  @@unique([provider, providerSessionId], map: "uq_swift_studio_sessions_v2_provider_locator")
  @@index([namespaceId, datasetVersion, createdAt, id], map: "idx_swift_studio_sessions_v2_dataset")
  @@index([namespaceId, status, createdAt, id], map: "idx_swift_studio_sessions_v2_status")
  @@map("swift_studio_sessions_v2")
}

model V2ModelArtifactImport {
  id                     String    @id @db.Uuid
  namespaceId            String    @map("namespace_id") @db.Uuid
  createDigest           String    @map("create_digest") @db.Char(64)
  status                 String
  studioSessionId        String    @map("studio_session_id") @db.Uuid
  outputHandleDigest     String    @map("output_handle_digest") @db.Char(64)
  artifactKind           String    @map("artifact_kind")
  displayName            String    @map("display_name")
  baseModelReference     String    @map("base_model_reference")
  baseModelRevision      String?   @map("base_model_revision")
  providerImportId       String?   @unique(map: "uq_model_artifact_imports_v2_provider_import") @map("provider_import_id")
  outputSnapshotDigest   String?   @map("output_snapshot_digest") @db.Char(64)
  stagingObjectKey       String?   @map("staging_object_key")
  archiveDigest          String?   @map("archive_digest") @db.Char(64)
  archiveSizeBytes       BigInt?   @map("archive_size_bytes")
  manifestDigest         String?   @map("manifest_digest") @db.Char(64)
  manifest               Json?     @map("manifest_json")
  datasetLineageStatus   String?   @map("dataset_lineage_status")
  datasetVersion         String?   @map("dataset_version") @db.Char(64)
  datasetExportDigest    String?   @map("dataset_export_digest") @db.Char(64)
  baseModelBindingStatus String?   @map("base_model_binding_status")
  artifactId             String?   @unique(map: "uq_model_artifact_imports_v2_artifact") @map("artifact_id") @db.Uuid
  failure                Json?     @map("failure_json")
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  stagingAt              DateTime? @map("staging_at") @db.Timestamptz(6)
  finalizingAt           DateTime? @map("finalizing_at") @db.Timestamptz(6)
  completedAt            DateTime? @map("completed_at") @db.Timestamptz(6)
  failedAt               DateTime? @map("failed_at") @db.Timestamptz(6)
  stagingCleanedAt       DateTime? @map("staging_cleaned_at") @db.Timestamptz(6)
  updatedAt              DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  namespace         V2IdentityNamespace  @relation(fields: [namespaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  studioSession     V2SwiftStudioSession @relation(fields: [studioSessionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  dataset           V2DatasetSnapshot?   @relation(fields: [datasetVersion], references: [version], onDelete: Restrict, onUpdate: Restrict)
  publishedArtifact V2ModelArtifact?     @relation("SourceModelArtifactImport")

  @@unique([namespaceId, createDigest], map: "uq_model_artifact_imports_v2_create_digest")
  @@unique([namespaceId, studioSessionId, outputHandleDigest, artifactKind], map: "uq_model_artifact_imports_v2_output")
  @@index([namespaceId, status, createdAt, id], map: "idx_model_artifact_imports_v2_status")
  @@index([studioSessionId, createdAt, id], map: "idx_model_artifact_imports_v2_session")
  @@map("model_artifact_imports_v2")
}

model V2ModelArtifact {
  id                     String   @id @db.Uuid
  namespaceId            String   @map("namespace_id") @db.Uuid
  displayName            String   @map("display_name")
  artifactKind           String   @map("artifact_kind")
  artifactFormat         String   @map("artifact_format")
  archiveFormat          String   @map("archive_format")
  archiveDigest          String   @map("archive_digest") @db.Char(64)
  archiveSizeBytes       BigInt   @map("archive_size_bytes")
  objectLocator          String   @map("object_locator")
  manifestDigest         String   @map("manifest_digest") @db.Char(64)
  manifest               Json     @map("manifest_json")
  sourceKind             String   @map("source_kind")
  sourceSessionId        String   @map("source_session_id") @db.Uuid
  sourceImportId         String   @unique(map: "uq_model_artifacts_v2_source_import") @map("source_import_id") @db.Uuid
  datasetLineageStatus   String   @map("dataset_lineage_status")
  datasetVersion         String?  @map("dataset_version") @db.Char(64)
  datasetExportDigest    String?  @map("dataset_export_digest") @db.Char(64)
  baseModelReference     String   @map("base_model_reference")
  baseModelRevision      String?  @map("base_model_revision")
  baseModelBindingStatus String   @map("base_model_binding_status")
  upstreamCommit         String   @map("upstream_commit") @db.Char(40)
  imageDigest            String   @map("image_digest") @db.Char(64)
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  namespace        V2IdentityNamespace   @relation(fields: [namespaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sourceSession    V2SwiftStudioSession  @relation(fields: [sourceSessionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sourceImport     V2ModelArtifactImport @relation("SourceModelArtifactImport", fields: [sourceImportId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  dataset          V2DatasetSnapshot?    @relation(fields: [datasetVersion], references: [version], onDelete: Restrict, onUpdate: Restrict)
  modelDeployments V2ModelDeployment[]

  @@unique([namespaceId, id], map: "uq_model_artifacts_v2_namespace_id")
  @@index([namespaceId, archiveDigest], map: "idx_model_artifacts_v2_archive_digest")
  @@index([namespaceId, createdAt, id], map: "idx_model_artifacts_v2_created")
  @@index([namespaceId, datasetVersion, createdAt, id], map: "idx_model_artifacts_v2_dataset")
  @@map("model_artifacts_v2")
}

model V2ModelDeployment {
  id              String    @id @db.Uuid
  namespaceId     String    @map("namespace_id") @db.Uuid
  createDigest    String    @map("create_digest") @db.Char(64)
  artifactId      String    @map("artifact_id") @db.Uuid
  provider        String
  displayName     String    @map("display_name")
  servedModelName String    @map("served_model_name")
  endpointBaseUrl String    @map("endpoint_base_url")
  authMode        String    @map("auth_mode")
  status          String
  healthStatus    String    @default("unknown") @map("health_status")
  healthCheckedAt DateTime? @map("health_checked_at") @db.Timestamptz(6)
  healthError     String?   @map("health_error")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  disabledAt      DateTime? @map("disabled_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  namespace      V2IdentityNamespace @relation(fields: [namespaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  artifact       V2ModelArtifact     @relation(fields: [namespaceId, artifactId], references: [namespaceId, id], onDelete: Restrict, onUpdate: Restrict)
  evaluationRuns V2EvaluationRun[]   @relation("V2EvaluationRunDeployment")

  @@unique([namespaceId, createDigest], map: "uq_model_deployments_v2_create_digest")
  @@unique([namespaceId, id, artifactId, createDigest], map: "uq_model_deployments_v2_namespace_id_artifact_digest")
  @@index([namespaceId, status, createdAt, id], map: "idx_model_deployments_v2_status")
  @@index([namespaceId, artifactId, createdAt, id], map: "idx_model_deployments_v2_artifact")
  @@map("model_deployments_v2")
}
